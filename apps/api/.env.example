PORT=4000
DATABASE_URL=postgresql://videoeditor:videoeditor@localhost:5432/videoeditor
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage-data
STORAGE_LOCAL_PUBLIC_URL=http://localhost:4000
STORAGE_LOCAL_UPLOAD_SECRET=change-me-upload-secret

CORS_ORIGIN=http://localhost:3000

# Optional — natural-language timeline editing and the prompt-to-first-draft
# auto-editor (apps/api/src/ai/) require this. Without it, those endpoints
# return a clear 503 rather than the server failing to boot.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
